{
  "name": "culinary-craft-prototype",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests playwright.config.js --max-warnings 0",
    "prelint:ci": "node scripts/prepare-reports.mjs",
    "lint:ci": "eslint src tests playwright.config.js --format json --output-file reports/frontend/static/eslint.json",
    "test": "node scripts/prepare-reports.mjs && vitest run",
    "test:watch": "vitest",
    "pretest:ci": "node scripts/prepare-reports.mjs",
    "test:ci": "vitest run --coverage",
    "pretest:e2e": "node scripts/prepare-reports.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.7.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "prettier": "^3.5.3",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
