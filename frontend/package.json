{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --format json --output-file reports/frontend/static/eslint.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "prelint:ci": "node scripts/prepare-reports.mjs",
    "pretest": "node scripts/prepare-reports.mjs",
    "pretest:ci": "node scripts/prepare-reports.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
